{
    "version": "1.5.0",
    "description": "SharkTrack configuration - copy to sharktrack_config.json (git-ignored) and edit paths to match your system",
    "project": {
        "name": "SharkTrack Project",
        "user_id": "USER",
        "description": "Marine video analysis project"
    },
    "paths": {
        "input_videos": "/path/to/BRUV/videos/",
        "output_results": "/path/to/results/",
        "validation_dir": "/path/to/results/validation/",
        "thumbnails_dir": "/path/to/results/detection_thumbnails/",
        "classifier_training_dir": "",
        "models_dir": "./models",
        "tracks_file": "/path/to/results/analysis_outputs/internal_results/tracks_for_validation.csv",
        "video_dirs": {
            "collection_name": "/path/to/BRUV/videos"
        }
    },
    "detection": {
        "confidence_threshold": 0.25,
        "device": "auto",
        "stereo_prefix": null,
        "auto_skip_deployment": true,
        "deployment_stability_threshold": 0.15
    },
    "validation": {
        "generate_thumbnails": true,
        "thumbnail_size": [
            640,
            480
        ],
        "smart_suggestions_enabled": true,
        "temporal_window_seconds": 120,
        "min_propagation_confidence": 0.7
    },
    "classifier_training": {
        "epochs": 50,
        "batch_size": 32,
        "learning_rate": 0.001,
        "include_metadata": true,
        "metadata_features": [
            "region",
            "depth_m",
            "season",
            "substrate",
            "water_clarity",
            "camera_model",
            "resolution"
        ]
    },
    "metadata": {
        "auto_extract_gopro": true,
        "auto_extract_gps": true,
        "auto_analyze_environment": true,
        "user_metadata_file": "/path/to/your_metadata.csv",
        "default_region": "",
        "default_habitat": "",
        "default_depth_m": null
    },
    "gui": {
        "port": 5000,
        "auto_open_browser": true,
        "theme": "light"
    }
}
